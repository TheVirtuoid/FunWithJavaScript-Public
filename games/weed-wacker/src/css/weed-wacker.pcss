
body {
    padding: 0;
    /*font-family: "Pixelify Sans", system-ui;*/
    font-family: "Press Start 2P", system-ui
}

main {
    display: flex;
    flex-direction: row;

    #panel {
        background-color: var(--v-color-primary200);
        height: stretch;
        padding: .5rem;

        h1 {
            font-size: 1.25rem;
            margin-block-end: .5em;
        }

        .stats, .weeds {

            ul {
                list-style-type: none;
                padding: 0;
                margin: 0;

                li {
                    display: flex;
                    flex-direction: row;
                    justify-content: space-between;
                    align-items: center;

                    &.time {
                        margin-block-end: .5em;
                    }

                    img {
                        width: 2rem;
                    }
                }
            }
        }

        .action-buttons {
            margin-block: 2rem;

            button {
                margin-block: 1rem;
                display: block;
            }

        }
    }

    #yard {
        height: stretch;
        background-color: var(--v-color-secondary200);
        flex-grow: 1;
        overflow: hidden;
    }
}
