body {
    background: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;

    font-family: "Press Start 2P", system-ui;
    font-weight: 400;
    font-style: normal;
}

.pixel-font {
    font-family: 'Pixelify Sans', cursive;
    -webkit-font-smoothing: none;
    -moz-osx-font-smoothing: grayscale;
    font-smooth: never;
}

.press-start-2p-regular {
    font-family: "Press Start 2P", system-ui;
    font-weight: 400;
    font-style: normal;
}
canvas {
    image-rendering: pixelated;
}